# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# mcp config (contains project references)
.mcp.json

# screenshots & playwright
*.png
!public/images/**/*.png
!public/favicon.ico
.playwright-mcp/

# vercel
.vercel

# script artifacts
scripts/test-output.pdf

# typescript
*.tsbuildinfo
next-env.d.ts
*.jpeg

# local agent/test junk
artifacts/
test-results/
.codex/
playwright-report/

# ad creatives / stock media (large binaries, kept local)
docs/ads/creatives/
docs/ads/stock/

# social post builds (rasterised example PDF, Zernio upload cache)
docs/social/**/.build/
docs/social/*/.zernio-uploads.json
docs/social/.tts-cache/
videos/*/renders/
videos/*/snapshots/
